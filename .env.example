# Copy to .env (gitignored) and adjust. Read by the API dev server,
# migrations, and the seed script.

# Local Postgres (Homebrew: brew services start postgresql@18; createdb apogee).
# No password needed for a local Homebrew install; it uses your Mac login.
DATABASE_URL=postgres://localhost:5432/apogee

# Optional overrides. Defaults: API on 8080, web on 3000, web proxies /api to the API.
# API_URL=http://localhost:8080
# HOST=0.0.0.0   # expose the web dev server to your phone on the LAN
